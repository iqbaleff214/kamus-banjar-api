# ─── Development environment — copy to .env.dev ──────────────────────────────
# Defaults below work out of the box for local development.

# MySQL credentials (used by both the mysql container and the API)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=kamusbanjar
MYSQL_USER=kamus
MYSQL_PASSWORD=kamus

# MySQL host port on your machine (change if 3306 is already in use)
MYSQL_PORT=3306

# API port on your machine
PORT=8001

# JWT — safe default for development only, never use this value in production
JWT_SECRET=dev-secret-key-change-in-production!!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Admin account seeded on first startup
ADMIN_EMAIL=iqbaleff214@gmail.com
ADMIN_PASSWORD=password
