# Domain for this API (e.g. kamus-banjar.yourdomain.com)
DOMAIN=kamus-banjar.yourdomain.com

# MySQL credentials
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=kamusbanjar
MYSQL_USER=kamus
MYSQL_PASSWORD=changeme

# JWT — REQUIRED. Must be at least 32 characters. Use a strong random value.
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars

# Token TTLs (Go duration format: 15m, 1h, 168h, etc.)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Optional: seed an admin account on first startup.
# Leave empty to skip admin seeding.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme_admin_password
